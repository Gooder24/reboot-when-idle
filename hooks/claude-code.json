{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x /usr/bin/reboot-when-idle || /usr/bin/reboot-when-idle hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x /usr/bin/reboot-when-idle || /usr/bin/reboot-when-idle hook tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x /usr/bin/reboot-when-idle || /usr/bin/reboot-when-idle hook end",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x /usr/bin/reboot-when-idle || /usr/bin/reboot-when-idle hook end",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x /usr/bin/reboot-when-idle || /usr/bin/reboot-when-idle hook close",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
